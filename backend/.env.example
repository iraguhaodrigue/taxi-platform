# Copy this file to ".env" and change the values.

# Database. By default it uses a simple local SQLite file so the project
# runs immediately with no setup. For production, use PostgreSQL, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/taxi
DATABASE_URL=sqlite:///./taxi.db

# Secret key used to sign login tokens. Change this to a long random string.
SECRET_KEY=change-this-to-a-long-random-secret

# How long a login token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Default pricing (used when seeding the database).
BASE_FARE=1000
RATE_PER_KM=400
RATE_PER_MIN=50

# OpenRouteService API key for real road-distance fare estimates (free tier).
# Sign up at https://openrouteservice.org/dev/#/signup
# Leave blank to fall back to straight-line (haversine) distance.
OPENROUTESERVICE_API_KEY=
